# ==============================================================================
# ESDISPATCH ENTERPRISE - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual production/staging values.
# ==============================================================================
# ARCHITECTURE NOTE:
# 1. Android App: Reads variables via Secrets Gradle Plugin -> BuildConfig.*
# 2. Next.js Admin: Reads NEXT_PUBLIC_* variables in client browser bundles.
# 3. Security: NEVER put server secret keys (e.g., Paystack Secret Key, Firebase
#    Service Account JSON, Private Auth Secrets) in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CORE CONFIGURATION
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-client-api-key
FIREBASE_APPLICATION_ID=your-android-app-id
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_GCM_SENDER_ID=your-project-number
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Next.js Web Admin (Exposed in browser bundles)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-client-api-key
NEXT_PUBLIC_FIREBASE_APPLICATION_ID=your-web-app-id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_GCM_SENDER_ID=your-project-number
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Vite Compatibility Fallbacks
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=your-client-api-key
VITE_FIREBASE_APPLICATION_ID=your-web-app-id
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS PLATFORM & PLACES AUTOCOMPLETE
# ------------------------------------------------------------------------------
# Restrict in Google Cloud Console:
# - Android: Package name (com.esdispatch.app) + SHA-1 fingerprint
# - Web: HTTP referrers (e.g. https://yourdomain.com/*, https://*.vercel.app/*)
GOOGLE_MAPS_API_KEY=AIzaSy...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...
NEXT_PUBLIC_MAPS_API_KEY=AIzaSy...
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...
MAPS_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 3. MAPBOX NAVIGATION & VECTOR TILES
# ------------------------------------------------------------------------------
# Generate URL-restricted public access token at https://account.mapbox.com
MAPBOX_ACCESS_TOKEN=pk.eyJ...
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & GOOGLE OAUTH
# ------------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=your-project-number-xxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-project-number-xxxx.apps.googleusercontent.com
FIREBASE_PHONE_AUTH_VERIFICATION_TOKEN=

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (PAYSTACK - PUBLIC KEY ONLY)
# ------------------------------------------------------------------------------
# ONLY use pk_live_... or pk_test_... here.
# NEVER expose sk_live_... (Secret Key) to client apps or GitHub!
PAYSTACK_PUBLIC_KEY=pk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# ------------------------------------------------------------------------------
# 6. AI & ASSISTANT CAPABILITIES
# ------------------------------------------------------------------------------
# NOTE: This must be a SEPARATE Gemini key (never the Maps key), restricted to
# the Generative Language API. Prefer proxying AI calls through a Cloud
# Function so the key never ships inside the client.
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 7. FIREBASE APP CHECK (DDoS & Scraping Protection)
# ------------------------------------------------------------------------------
# Web reCAPTCHA Enterprise Site Key (register at Google Cloud reCAPTCHA Enterprise)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ------------------------------------------------------------------------------
# 8. PRODUCTION SMTP LOGISTICS & DELIVERABILITY CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST=server.hostnextdns.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@engracedsmile.com
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@engracedsmile.com
SMTP_FROM_NAME=ESDispatch Logistics
# Set to "false" ONLY if your mail server uses a self-signed certificate.
# TLS certificate verification is ON by default.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 9. SERVER-SIDE OTP PEPPERS (Cloud Functions + Vercel serverless)
# ------------------------------------------------------------------------------
# Rotate periodically; must match between functions and api/email/verification.
OTP_PEPPER=ESDISPATCH_OTP_SECURE_PEPPER_2026
HANDOVER_OTP_PEPPER=ESDISPATCH_HANDOVER_OTP_PEPPER_2026

# ------------------------------------------------------------------------------
# 10. SERVERLESS ADMIN SDK (api/email/* + api/auth/check-phone)
# ------------------------------------------------------------------------------
# JSON service-account credentials for the Admin SDK. On Firebase Functions
# this is unnecessary (default credentials apply); Vercel needs it explicitly.
# FIREBASE_SERVICE_ACCOUNT={...}


rules_version = '2';

// ============================================================================
// ESDISPATCH FIRESTORE SECURITY RULES — HARDENED (2026-10-15 remediation)
//
// Fixes applied (per FULL_SYSTEM_AUDIT_2026-10-14.md):
//   C1  Escrow minting  — client writes to payment/settlement fields denied;
//       settlement only via server ledger refs (see functions/index.ts).
//   C2  Role escalation — rider role no longer self-assignable; riders come
//       from `rider_applications` approved by admins (trigger promotes).
//   C3  OTP secrecy     — plaintext OTP fields cannot be written or read by
//       clients; hashes live on the doc, plaintext in a locked collection.
//   C4  Tracking spoof  — public_tracking writes require existing-doc
//       participation (never payload self-claims).
//   C8  Notif broadcast — root notifications create is admin/dispatcher only.
//   C9  GPS privacy     — fleet_locations / riders / drivers read scoped.
//   C10 Subcollection leaks — support chats, marketplace, batches scoped.
//   C11 Money paths     — walletBalance writes denied to owners; bookings and
//       withdrawals are server-authoritative callables.
//   H10 PII surfaces    — phone_indices read requires auth; rider/vendor
//       profile reads require auth.
//   M9  Forged records  — root transactions/audit_logs/tips create scoped.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPERS
    // ===============================================================

    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuth() && (
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.get('isSuperAdmin', false) == true) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'owner', 'Owner'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'owner', 'Owner']
          )
        )
      );
    }

    function isAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.get('role', '') in ['admin', 'super_admin', 'manager', 'owner', 'Admin', 'SuperAdmin', 'Manager', 'Owner']) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'manager', 'Manager', 'owner', 'Owner'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'manager', 'Manager', 'owner', 'Owner']
          )
        )
      );
    }

    function isDispatcher() {
      return isAuth() && (
        isAdmin() ||
        (request.auth.token.get('role', '') in ['dispatcher', 'Dispatcher']) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['dispatcher', 'Dispatcher'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['dispatcher', 'Dispatcher']
          )
        )
      );
    }

    function isDeliveryParticipant(data) {
      return isAuth() && (
        data.get('userId', '') == request.auth.uid ||
        data.get('senderId', '') == request.auth.uid ||
        data.get('riderId', '') == request.auth.uid ||
        data.get('assignedRiderId', '') == request.auth.uid ||
        data.get('driverId', '') == request.auth.uid ||
        data.get('reservedRiderId', '') == request.auth.uid
      );
    }

    function isAvailableDelivery(data) {
      return data.get('status', '') in [
        'PENDING', 'QUEUED', 'OFFERED', 'pending', 'queued',
        'AVAILABLE', 'available', 'UNASSIGNED', 'unassigned', 'ASSIGNED_TO_POOL'
      ];
    }

    function isVerifiedRider() {
      return isAuth() && (
        request.auth.token.get('rider', false) == true ||
        exists(/databases/$(database)/documents/rider_profiles/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['rider', 'driver', 'RIDER', 'DRIVER'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['rider', 'driver', 'RIDER', 'DRIVER']
          )
        )
      );
    }

    function updateHasOnly(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // Payment / settlement integrity fields — never client-writable on update
    function paymentOtpGuardKeys() {
      return [
        'otpHash',
        'handoverCode', 'securityCode', 'payoutCredited', 'settlementStatus',
        'settlementBlockReason', 'paymentRef', 'paymentStatus', 'settlementApproved'
      ];
    }

    // Create-scope guard: paymentStatus is allowed as a KEY (drafts write
    // PENDING_PAYMENT) but its value must never be PAID — enforced separately.
    function createGuardKeys() {
      return [
        'otpHash', 'otpAttempts', 'otpExpiresAt', 'otpIssuedAt',
        'handoverCode', 'securityCode', 'payoutCredited', 'settlementStatus',
        'settlementBlockReason', 'paymentRef', 'settlementApproved'
      ];
    }

    function isReasonableWrite() {
      return request.resource.data.keys().size() <= 150;
    }

    function isValidPinValue(val) {
      return val is string && (
        (val.size() == 4 && val.matches('^[0-9]{4}$')) ||
        (val.size() == 64 && val.matches('^[0-9a-fA-F]{64}$'))
      );
    }

    function isValidDeliveryOtp(val) {
      return val is string && (
        val == '' ||
        (val.size() == 4 && val.matches('^[0-9]{4}$'))
      );
    }

    function validPinCreate(key) {
      return !request.resource.data.keys().hasAny([key]) ||
        isValidPinValue(request.resource.data[key]);
    }

    function validPinUpdate(key) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([key]) ||
        (!request.resource.data.keys().hasAny([key]) || isValidPinValue(request.resource.data[key]));
    }

    function validUserPinsOnCreate() {
      return validPinCreate('pin') &&
        validPinCreate('userPin') &&
        validPinCreate('securityPin') &&
        validPinCreate('pinHash');
    }

    function validUserPinsOnUpdate() {
      return validPinUpdate('pin') &&
        validPinUpdate('userPin') &&
        validPinUpdate('securityPin') &&
        validPinUpdate('pinHash');
    }

    // ===============================================================
    // USER PROFILES & SUBCOLLECTIONS
    // ===============================================================

    match /users/{userId} {
      // Owner, admin, and dispatcher can always read the full profile.
      // Rider/driver/vendor PUBLIC-ish profile reads now REQUIRE auth (C9/H10)
      // and never expose security credentials or financial balances.
      allow read: if isOwner(userId) || isAdmin() || isDispatcher() ||
        (
          isAuth() &&
          (
            resource.data.get('role', '') in ['rider', 'driver', 'vendor', 'RIDER', 'DRIVER', 'VENDOR'] ||
            resource.data.get('userRole', '') in ['rider', 'driver', 'vendor', 'RIDER', 'DRIVER', 'VENDOR']
          ) &&
          !resource.data.keys().hasAny(['pin', 'userPin', 'securityPin', 'pinHash', 'walletBalance', 'vendorBalance'])
        );

      // Prevent non-admin privilege escalation on creation.
      // 'rider' is no longer self-assignable (C2): fleet enrollment goes
      // through rider_applications → admin approval.
      allow create: if isAuth() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.keys().hasAny([
            'admin', 'isSuperAdmin', 'permissions', 'riderApproved', 'emailVerified'
          ]) &&
          validUserPinsOnCreate() &&
          !(request.resource.data.get('role', '') in ['admin', 'super_admin', 'dispatcher', 'manager', 'owner', 'rider', 'Admin', 'SuperAdmin', 'Dispatcher', 'Manager', 'Owner', 'Rider']) &&
          !(request.resource.data.get('userRole', '') in ['admin', 'super_admin', 'dispatcher', 'manager', 'owner', 'rider', 'Admin', 'SuperAdmin', 'Dispatcher', 'Manager', 'Owner', 'Rider']) &&
          request.resource.data.get('walletBalance', 0) == 0 &&
          request.resource.data.get('vendorBalance', 0) == 0
        )
      );

      // Owners may update general profile fields and manage their security PIN;
      // sensitive fields are server-controlled (Admin SDK). Wallet debits (decrements)
      // are allowed for client-side bookings and withdrawals; credits require server/admin.
      allow update: if isAuth() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'userRole', 'admin', 'isSuperAdmin', 'permissions',
            'vendorBalance', 'email', 'emailVerified', 'riderApproved'
          ]) &&
          validUserPinsOnUpdate() &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance']) ||
            request.resource.data.get('walletBalance', 0) <= resource.data.get('walletBalance', 0)
          )
        ) ||
        (
          isVerifiedRider() &&
          updateHasOnly(['loyaltyPoints', 'deliveryCount'])
        )
      );

      allow delete: if isSuperAdmin();

      // Notifications inbox: recipients and admins manage; creation is
      // restricted to the owner so strangers cannot spam inboxes (C8).
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
      }

      // Notification dedupe events: same scoping.
      match /notification_events/{eventId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
      }

      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if isAuth() && (
          request.auth.uid == userId ||
          request.resource.data.get('customerId', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid
        );
        allow update, delete: if isAdmin();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth() && (
          request.resource.data.get('authorId', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid
        );
        allow update, delete: if isAdmin() || (
          isAuth() && resource.data.get('authorId', '') == request.auth.uid
        );
      }

      match /cart/{cartId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /payment_cards/{cardId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /deliveries/{deliveryId} {
        allow read, write: if isOwner(userId) || isAdmin() || isDispatcher() || isVerifiedRider() ||
          (isAuth() && (
            (exists(/databases/$(database)/documents/deliveries/$(deliveryId)) &&
             isDeliveryParticipant(get(/databases/$(database)/documents/deliveries/$(deliveryId)).data)) ||
            (exists(/databases/$(database)/documents/parcels/$(deliveryId)) &&
             isDeliveryParticipant(get(/databases/$(database)/documents/parcels/$(deliveryId)).data))
          ));
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuth();
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      match /security_events/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /activity_logs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        // Wallet transaction mirrors are cosmetic; the authoritative ledger
        // is server-only (system_ledger). Owners may only record their own.
        allow create: if isOwner(userId) && (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == userId
        );
        allow update, delete: if isAdmin();
      }

      // C2: the legacy rider-escalation subcollection is fully denied.
      match /riders/{riderId} {
        allow read, write: if false;
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // PHONE REGISTRY (H10: requires auth to read)
    // ===============================================================

    match /phone_indices/{phoneKey} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isAdmin() ||
        (request.resource.data.get('uid', '') == request.auth.uid)
      );
      allow update: if isAuth() && (
        isAdmin() ||
        (resource.data.get('uid', '') == request.auth.uid && request.resource.data.get('uid', '') == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // DELIVERIES (core booking / tracking documents)
    // ===============================================================

    match /deliveries/{deliveryId} {
      allow list: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.assignedRiderId == request.auth.uid ||
        resource.data.reservedRiderId == request.auth.uid ||
        (
          isVerifiedRider() &&
          resource.data.status in [
            'PENDING', 'QUEUED', 'OFFERED', 'pending', 'queued',
            'AVAILABLE', 'available', 'UNASSIGNED', 'unassigned', 'ASSIGNED_TO_POOL'
          ]
        )
      );

      allow get: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        isDeliveryParticipant(resource.data) ||
        (isVerifiedRider() && isAvailableDelivery(resource.data)) ||
        (request.auth.token.get('phone_number', '') != '' && request.auth.token.phone_number == resource.data.get('receiverPhone', ''))
      );

      // Client creates are allowed for customers (including wallet-paid bookings)
      // and by admins/dispatchers booking on behalf of customers.
      // C1: no payment/settlement fields, no rider self-assignment.
      allow create: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        (
          request.resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('riderId', '') == '' &&
          request.resource.data.get('driverId', '') == '' &&
          !request.resource.data.keys().hasAny(createGuardKeys()) &&
          isValidDeliveryOtp(request.resource.data.get('otpCode', '')) &&
          isReasonableWrite()
        )
      );

      // C1: participant updates deny-list money/payment fields. Riders
      // may manage operational state & verify OTP; customers may edit booking details,
      // set missing OTP, and may only cancel (status → CANCELLED).
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        (
          isDeliveryParticipant(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(paymentOtpGuardKeys()) &&
          (
            // Rider operational updates
            (
              (
                resource.data.get('riderId', '') == request.auth.uid ||
                resource.data.get('driverId', '') == request.auth.uid ||
                resource.data.get('assignedRiderId', '') == request.auth.uid
              ) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'price', 'deliveryFee', 'tipAmount', 'userId', 'senderId',
                'assignedRiderId', 'reservedRiderId', 'riderId', 'driverId',
                'receiverPhone', 'receiverName', 'recipientName', 'recipientEmail',
                'otpCode'
              ])
            ) ||
            // Customer booking edits (money fields lock once PAID)
            (
              resource.data.get('userId', '') == request.auth.uid &&
              (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['otpCode']) ||
                (
                  resource.data.get('otpCode', '') == '' &&
                  request.resource.data.get('otpCode', '') is string &&
                  request.resource.data.get('otpCode', '').matches('^[0-9]{4}$')
                )
              ) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'riderId', 'driverId', 'assignedRiderId', 'reservedRiderId',
                'courierName', 'courierPhone', 'riderBikeNumber',
                'courierLatitude', 'courierLongitude', 'progress',
                'pickupPhotoUrl', 'arrivalPhotoUrl', 'podUrl', 'otpVerified'
              ]) &&
              (
                resource.data.get('paymentStatus', '') != 'PAID' ||
                !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                  'price', 'deliveryFee', 'tipAmount'
                ])
              ) &&
              (
                request.resource.data.get('status', resource.data.get('status', '')) == resource.data.get('status', '') ||
                request.resource.data.get('status', '') in ['CANCELLED', 'cancelled', 'Cancelled']
              )
            )
          )
        ) ||
        // Verified rider claiming an unassigned pool delivery
        (
          isVerifiedRider() &&
          isAvailableDelivery(resource.data) &&
          resource.data.get('riderId', '') == '' &&
          request.resource.data.get('riderId', '') == request.auth.uid &&
          updateHasOnly([
            'riderId', 'driverId', 'assignedRiderId', 'reservedRiderId',
            'status', 'courierName', 'courierPhone', 'riderBikeNumber',
            'progress', 'assignedAt', 'acceptedAt', 'lastUpdated',
            'updatedAt', 'initialCourierLat', 'initialCourierLng',
            'courierLatitude', 'courierLongitude', 'courierBearing',
            'courierSpeed', 'courierAccuracy'
          ])
        )
      );

      allow delete: if isAdmin();

      // Subcollections: messages, timeline, chats, POD — participants & verified riders.
      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          isVerifiedRider() ||
          (
            exists(/databases/$(database)/documents/deliveries/$(deliveryId)) &&
            isDeliveryParticipant(get(/databases/$(database)/documents/deliveries/$(deliveryId)).data)
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // PARCELS (mirror of deliveries; legacy + mirrored documents)
    // ===============================================================

    match /parcels/{parcelId} {
      allow list: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.assignedRiderId == request.auth.uid ||
        resource.data.reservedRiderId == request.auth.uid ||
        (
          isVerifiedRider() &&
          resource.data.status in [
            'PENDING', 'QUEUED', 'OFFERED', 'pending', 'queued',
            'AVAILABLE', 'available', 'UNASSIGNED', 'unassigned', 'ASSIGNED_TO_POOL'
          ]
        )
      );

      allow get: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        isDeliveryParticipant(resource.data) ||
        (isVerifiedRider() && isAvailableDelivery(resource.data)) ||
        (request.auth.token.get('phone_number', '') != '' && request.auth.token.phone_number == resource.data.get('receiverPhone', ''))
      );

      allow create: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        (
          request.resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('riderId', '') == '' &&
          request.resource.data.get('driverId', '') == '' &&
          !request.resource.data.keys().hasAny(createGuardKeys()) &&
          isValidDeliveryOtp(request.resource.data.get('otpCode', '')) &&
          isReasonableWrite()
        )
      );

      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        (
          isDeliveryParticipant(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(paymentOtpGuardKeys()) &&
          (
            (
              (
                resource.data.get('riderId', '') == request.auth.uid ||
                resource.data.get('driverId', '') == request.auth.uid ||
                resource.data.get('assignedRiderId', '') == request.auth.uid
              ) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'price', 'deliveryFee', 'tipAmount', 'userId', 'senderId',
                'assignedRiderId', 'reservedRiderId', 'riderId', 'driverId',
                'receiverPhone', 'receiverName', 'recipientName', 'recipientEmail',
                'otpCode'
              ])
            ) ||
            (
              resource.data.get('userId', '') == request.auth.uid &&
              (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['otpCode']) ||
                (
                  resource.data.get('otpCode', '') == '' &&
                  request.resource.data.get('otpCode', '') is string &&
                  request.resource.data.get('otpCode', '').matches('^[0-9]{4}$')
                )
              ) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'riderId', 'driverId', 'assignedRiderId', 'reservedRiderId',
                'courierName', 'courierPhone', 'riderBikeNumber',
                'courierLatitude', 'courierLongitude', 'progress',
                'pickupPhotoUrl', 'arrivalPhotoUrl', 'podUrl', 'otpVerified'
              ]) &&
              (
                resource.data.get('paymentStatus', '') != 'PAID' ||
                !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                  'price', 'deliveryFee', 'tipAmount'
                ])
              ) &&
              (
                request.resource.data.get('status', resource.data.get('status', '')) == resource.data.get('status', '') ||
                request.resource.data.get('status', '') in ['CANCELLED', 'cancelled', 'Cancelled']
              )
            )
          )
        ) ||
        (
          isVerifiedRider() &&
          isAvailableDelivery(resource.data) &&
          resource.data.get('riderId', '') == '' &&
          request.resource.data.get('riderId', '') == request.auth.uid &&
          updateHasOnly([
            'riderId', 'driverId', 'assignedRiderId', 'reservedRiderId',
            'status', 'courierName', 'courierPhone', 'riderBikeNumber',
            'progress', 'assignedAt', 'acceptedAt', 'lastUpdated',
            'updatedAt', 'initialCourierLat', 'initialCourierLng',
            'courierLatitude', 'courierLongitude', 'courierBearing',
            'courierSpeed', 'courierAccuracy'
          ])
        )
      );

      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          isVerifiedRider() ||
          (
            exists(/databases/$(database)/documents/parcels/$(parcelId)) &&
            isDeliveryParticipant(get(/databases/$(database)/documents/parcels/$(parcelId)).data)
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // PUBLIC TRACKING PROJECTION (C4: spoof-proof writes)
    // ===============================================================

    match /public_tracking/{deliveryId} {
      // Public read for recipients tracking orders via link.
      allow read: if true;
      // Writes require participation on the EXISTING document — payload
      // self-claims no longer grant access (C4).
      allow write: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        (
          resource != null && (
            resource.data.get('riderId', '') == request.auth.uid ||
            resource.data.get('userId', '') == request.auth.uid ||
            resource.data.get('assignedRiderId', '') == request.auth.uid
          )
        )
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          (
            exists(/databases/$(database)/documents/public_tracking/$(deliveryId)) && (
              get(/databases/$(database)/documents/public_tracking/$(deliveryId)).data.get('riderId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/public_tracking/$(deliveryId)).data.get('userId', '') == request.auth.uid
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // SERVER-LOCKED COLLECTIONS
    // ===============================================================

    // Handover OTP plaintext (C3): only the Admin SDK may read/write.
    match /delivery_otp_secrets/{docId} {
      allow read, write: if false;
    }

    // Payment ledger: server-only writes; owner & admin reads.
    match /system_ledger/{docId} {
      allow read: if isAuth() && (
        isAdmin() || resource.data.get('userId', '') == request.auth.uid
      );
      allow write: if false;
    }

    match /settlement_records/{docId} {
      allow read: if isAdmin() || isDispatcher();
      allow write: if false;
    }

    match /payout_settlements/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===============================================================
    // RIDER ENROLLMENT (C2: application → admin approval)
    // ===============================================================

    match /rider_applications/{uid} {
      allow read: if isAuth() && (
        isOwner(uid) || isAdmin() || isDispatcher()
      );
      allow create: if isAuth() && (
        request.auth.uid == uid &&
        request.resource.data.get('status', '') == 'PENDING' &&
        !request.resource.data.keys().hasAny(['approvedBy', 'approvedAt', 'rejectionReason'])
      );
      allow update: if isAdmin() || isDispatcher();
      allow delete: if isAdmin();
    }

    match /rider_profiles/{uid} {
      allow read: if isAuth() && (
        isOwner(uid) || isAdmin() || isDispatcher()
      );
      allow write: if false; // Cloud Functions only
    }

    match /withdrawal_requests/{docId} {
      allow read: if isAuth() && (
        isAdmin() || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if false; // server callable only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // FLEET: LOCATIONS, RIDERS, DRIVERS, ATTENDANCE
    // ===============================================================

    // C9: live GPS is readable by admins, dispatchers, the rider, or the assigned customer.
    match /fleet_locations/{riderId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        request.auth.uid == riderId ||
        (
          resource.data.get('activeBookingId', '') != '' && (
            (exists(/databases/$(database)/documents/deliveries/$(resource.data.activeBookingId)) &&
             get(/databases/$(database)/documents/deliveries/$(resource.data.activeBookingId)).data.get('userId', '') == request.auth.uid) ||
            (exists(/databases/$(database)/documents/parcels/$(resource.data.activeBookingId)) &&
             get(/databases/$(database)/documents/parcels/$(resource.data.activeBookingId)).data.get('userId', '') == request.auth.uid)
          )
        )
      );
      allow write: if isAuth() && (request.auth.uid == riderId || isAdmin() || isDispatcher());
      allow delete: if isAdmin();
    }

    match /riders/{riderId} {
      // C9: profiles readable only by self, admins and dispatchers.
      allow read: if isAuth() && (
        isAdmin() || isDispatcher() || request.auth.uid == riderId
      );
      allow create: if isAuth() && (request.auth.uid == riderId || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        (request.auth.uid == riderId && updateHasOnly([
          'isOnline', 'status', 'lat', 'lng', 'latitude', 'longitude',
          'lastSeen', 'lastHeartbeat', 'updatedAt', 'name', 'phone', 'bikeNumber'
        ]))
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == riderId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /drivers/{driverId} {
      allow read: if isAuth() && (
        isAdmin() || isDispatcher() || request.auth.uid == driverId
      );
      allow create: if isAuth() && (request.auth.uid == driverId || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        (request.auth.uid == driverId && updateHasOnly([
          'isOnline', 'status', 'lat', 'lng', 'latitude', 'longitude',
          'lastSeen', 'lastHeartbeat', 'updatedAt', 'name', 'phone', 'bikeNumber'
        ]))
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == driverId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /rider_attendance/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        request.resource.data.get('riderId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDispatcher();
    }

    match /vehicle_inspections/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('driverId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        request.resource.data.get('riderId', '') == request.auth.uid ||
        request.resource.data.get('driverId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDispatcher();
    }

    // ===============================================================
    // SUPPORT CHATS (C10: participant scoping)
    // ===============================================================

    match /support_chats/{ticketId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('customerId', '') == request.auth.uid ||
        request.resource.data.get('riderId', '') == request.auth.uid
      );
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          (
            exists(/databases/$(database)/documents/support_chats/$(ticketId)) &&
            (
              get(/databases/$(database)/documents/support_chats/$(ticketId)).data.get('userId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/support_chats/$(ticketId)).data.get('customerId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/support_chats/$(ticketId)).data.get('riderId', '') == request.auth.uid
            )
          )
        );
        allow delete: if isAdmin();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          (
            exists(/databases/$(database)/documents/support_chats/$(ticketId)) &&
            (
              get(/databases/$(database)/documents/support_chats/$(ticketId)).data.get('userId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/support_chats/$(ticketId)).data.get('customerId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/support_chats/$(ticketId)).data.get('riderId', '') == request.auth.uid
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // MARKETPLACE (C10: vendor-scoped writes)
    // ===============================================================

    match /marketplace_products/{productId} {
      allow read: if true;
      allow create: if isAuth() && (
        isAdmin() ||
        (
          request.resource.data.get('vendorId', '') != '' &&
          exists(/databases/$(database)/documents/marketplace_stores/$(request.resource.data.get('vendorId', ''))) &&
          get(/databases/$(database)/documents/marketplace_stores/$(request.resource.data.get('vendorId', ''))).data.get('ownerId', '') == request.auth.uid
        )
      );
      allow update, delete: if isAuth() && (
        isAdmin() ||
        (
          resource.data.get('vendorId', '') != '' &&
          exists(/databases/$(database)/documents/marketplace_stores/$(resource.data.get('vendorId', ''))) &&
          get(/databases/$(database)/documents/marketplace_stores/$(resource.data.get('vendorId', ''))).data.get('ownerId', '') == request.auth.uid
        )
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth() && (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/marketplace_products/$(productId)) &&
            get(/databases/$(database)/documents/marketplace_products/$(productId)).data.get('vendorId', '') != '' &&
            exists(/databases/$(database)/documents/marketplace_stores/$(get(/databases/$(database)/documents/marketplace_products/$(productId)).data.get('vendorId', ''))) &&
            get(/databases/$(database)/documents/marketplace_stores/$(get(/databases/$(database)/documents/marketplace_products/$(productId)).data.get('vendorId', ''))).data.get('ownerId', '') == request.auth.uid
          )
        );
        allow delete: if isAdmin();
      }
    }

    match /marketplace_stores/{storeId} {
      allow read: if true;
      allow create: if isAuth() && (
        isAdmin() ||
        (
          request.resource.data.get('ownerId', '') == request.auth.uid &&
          request.resource.data.get('status', '') in ['PENDING', 'pending', 'Pending'] &&
          request.resource.data.get('isVerified', false) == false &&
          !request.resource.data.keys().hasAny(['vendorBalance', 'vendorWallet', 'totalSales', 'totalSettled', 'commissionRate'])
        )
      );
      // Store owners cannot self-verify, self-feature, or touch balances.
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.get('ownerId', '') == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isVerified', 'isFeatured', 'featuredRank', 'kycStatus',
            'vendorBalance', 'vendorWallet', 'totalSales', 'totalSettled',
            'commissionRate', 'ownerId', 'status'
          ])
        )
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth() && (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/marketplace_stores/$(storeId)) &&
            get(/databases/$(database)/documents/marketplace_stores/$(storeId)).data.get('ownerId', '') == request.auth.uid
          )
        );
        allow delete: if isAdmin();
      }
    }

    match /marketplace_orders/{orderId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('buyerId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('buyerId', '') == request.auth.uid &&
        request.resource.data.get('paymentStatus', 'PENDING_PAYMENT') != 'PAID' &&
        !request.resource.data.keys().hasAny(['paymentRef', 'vendorSplits', 'settledAt'])
      );
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('buyerId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          (
            exists(/databases/$(database)/documents/marketplace_orders/$(orderId)) && (
              get(/databases/$(database)/documents/marketplace_orders/$(orderId)).data.get('buyerId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/marketplace_orders/$(orderId)).data.get('userId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/marketplace_orders/$(orderId)).data.get('vendorId', '') == request.auth.uid
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // PLATFORM CONFIG & ADMIN SURFACES
    // ===============================================================

    match /system_config/{docId} {
      // Pricing/geo/global settings are configuration (not secrets) and are
      // read by the apps. Writes are admin-only (dispatcher write removed).
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /sub_admins/{docId} {
      allow read: if isAdmin() || isDispatcher();
      allow write: if isAdmin();
    }

    // ===============================================================
    // NOTIFICATIONS & BROADCASTS (C8: create is admin/dispatcher only)
    // ===============================================================

    match /notifications/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.get('recipientId', '') == request.auth.uid
      );
      allow create: if isAdmin() || isDispatcher();
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.get('recipientId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /broadcast_news/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isDispatcher();
    }

    match /fleet_broadcasts/{docId} {
      allow read: if isAuth();
      // Bookings, dispatchers, and riders claiming dispatches may write broadcasts
      allow create, update: if isAuth() && (
        isAdmin() || isDispatcher() || isVerifiedRider() ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin() || isDispatcher();
    }

    // ===============================================================
    // AUDIT & INCIDENTS (M9: forged audit entries blocked)
    // ===============================================================

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuth() && (
        isAdmin() || isDispatcher() || isVerifiedRider() ||
        request.resource.data.get('actorId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if false; // Immutable audit trail
    }

    match /incident_reports/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('reporterId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('reporterId', '') == request.auth.uid ||
        request.resource.data.get('riderId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('reporterId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // REVIEWS & RATINGS (root collections)
    // ===============================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && (
        request.resource.data.get('authorId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAuth() && (
        isAdmin() || resource.data.get('authorId', '') == request.auth.uid
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth() && (
          isAdmin() || request.resource.data.get('authorId', '') == request.auth.uid
        );
        allow delete: if isAdmin();
      }
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuth() && (
        request.resource.data.get('customerId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAuth() && (
        isAdmin() || resource.data.get('customerId', '') == request.auth.uid
      );
    }

    // ===============================================================
    // TIPS, WITHDRAWALS, REFUNDS, PAYOUTS
    // ===============================================================

    match /rider_tips/{tipId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() ||
        (
          request.resource.data.get('customerId', '') == request.auth.uid &&
          request.resource.data.get('userId', '') == request.auth.uid
        )
      );
      allow update, delete: if isAdmin();
    }

    match /tip_withdrawals/{docId} {
      allow read: if isAuth() && (
        isAdmin() || resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('riderId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /refund_requests/{docId} {
      allow read: if isAuth() && (
        isAdmin() || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /vendor_payout_requests/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('vendorId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // TRANSACTIONS (root ledger — server-authoritative)
    // ===============================================================

    match /transactions/{docId} {
      allow read: if isAuth() && (
        isAdmin() || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() || request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // LOYALTY & REFERRALS
    // ===============================================================

    match /customer_loyalty_points/{docId} {
      allow read: if isAdmin() || (
        isAuth() && resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() || isVerifiedRider() || request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isAuth() && resource.data.get('userId', '') == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId'])
      );
    }

    match /referrals/{docId} {
      allow read: if isAuth() && (
        isAdmin() || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /referral_redemptions/{docId} {
      allow read: if isAuth() && (
        isAdmin() || resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // BATCH BOOKINGS
    // ===============================================================

    match /batch_bookings/{batchId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('paymentStatus', 'PENDING_PAYMENT') != 'PAID' &&
        !request.resource.data.keys().hasAny(['paymentRef'])
      );
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          (
            exists(/databases/$(database)/documents/batch_bookings/$(batchId)) && (
              get(/databases/$(database)/documents/batch_bookings/$(batchId)).data.get('userId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/batch_bookings/$(batchId)).data.get('riderId', '') == request.auth.uid
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    match /batches/{batchId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('paymentStatus', 'PENDING_PAYMENT') != 'PAID' &&
        !request.resource.data.keys().hasAny(['paymentRef'])
      );
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (
          isAdmin() ||
          isDispatcher() ||
          (
            exists(/databases/$(database)/documents/batches/$(batchId)) && (
              get(/databases/$(database)/documents/batches/$(batchId)).data.get('userId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/batches/$(batchId)).data.get('riderId', '') == request.auth.uid
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // OFFLINE SYNC & PUBLIC FORMS
    // ===============================================================

    match /offline_sync_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contacts/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'message', 'subject', 'createdAt', 'timestamp'
      ]) && isReasonableWrite();
      allow update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'timestamp']) && isReasonableWrite();
      allow update, delete: if isAdmin();
    }

    match /account_deletion_requests/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['userId', 'email', 'phone', 'name', 'reason', 'status', 'createdAt', 'requestedAt', 'source']) && isReasonableWrite();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // ADDRESS REGISTRY (public landmarks & geocoded zones)
    // ===============================================================

    match /address_registry/{entryId} {
      // Public read so fare estimates and booking landmarks resolve instantly.
      allow read: if true;
      // Registry entries are managed exclusively by admin/dispatcher.
      allow write: if isAdmin() || isDispatcher();
    }

    // ===============================================================
    // VERIFICATION OTPS (server-locked)
    // ===============================================================

    match /verification_otps/{docId} {
      allow read, write: if false; // Admin SDK only
    }
  }
}
